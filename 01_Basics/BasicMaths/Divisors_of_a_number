import java.util.*;
class Solution {
    public int[] divisors(int n) {
        
       ArrayList<Integer>list=new ArrayList<>();
        
        for(int i=1;i<=Math.sqrt(n);i++){
            if(n%i==0){
                list.add(i);
                if((n/i!=i)){ 
                    list.add(n/i);   
            }
         }
     }

        Collections.sort(list);
        int[]result=new int[list.size()];

        for(int i=0;i<list.size();i++){
        result[i] = list.get(i);
        }

    return result;

    }
}
